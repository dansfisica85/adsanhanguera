IDE_PUBLIC_URL=https://ide.seudominio.com
PLATFORM_ORIGIN=https://plataforma.seudominio.com
# Preencher fora do repositório com um segredo aleatório próprio (32+ caracteres).
IDE_GATEWAY_TOKEN=
IDE_BIND_ADDRESS=127.0.0.1
IDE_PORT=3100
IDE_WORKSPACE_IMAGE=ads-ide-workspace:4.141.0
IDE_NETWORK_MODE=isolated
IDE_MAX_RUNNING_USERS=10
IDE_MEMORY_MB=1024
IDE_CPUS=1
IDE_PIDS_LIMIT=256
IDE_SESSION_MINUTES=30
IDE_IDLE_MINUTES=30
