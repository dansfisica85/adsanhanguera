# Instalar em contexto http; certificado deve cobrir a origem base E o wildcard.
map $http_upgrade $ide_connection_upgrade {
    default upgrade;
    '' close;
}
server {
    listen 443 ssl;
    server_name ide.seudominio.com *.ide.seudominio.com;
    ssl_certificate /etc/letsencrypt/live/ide.seudominio.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ide.seudominio.com/privkey.pem;
    client_max_body_size 25m;

    location / {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $ide_connection_upgrade;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 3600s;
        proxy_buffering off;
    }
}
